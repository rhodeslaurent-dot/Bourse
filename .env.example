# Copier en .env (gitignoré). Aucun secret ailleurs (CLAUDE.md règle 6).
DATABASE_URL=postgresql+psycopg://bourse:CHANGE_ME@postgres:5432/bourse
POSTGRES_NETWORK=postgres_default          # réseau Docker de l'instance Postgres existante
BACKUP_HOST_DIR=C:/Users/<vous>/OneDrive/bourse-backups
BACKUP_RETENTION_DAYS=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=0                          # votre user_id (BotFather / @userinfobot)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bourse.<nom>@gmail.com
SMTP_PASSWORD=                              # mot de passe d'application Gmail
EMAIL_TO=

CLOUDFLARE_TUNNEL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=<equipe>.cloudflareaccess.com
CF_ACCESS_AUD=                              # Application Audience (AUD) tag de l'application Access
CF_ACCESS_EMAIL=                            # seule adresse autorisée

EODHD_API_TOKEN=                            # plan EOD+Intraday
SAXO_APP_KEY=                               # application « usage personnel » developer.saxo (lecture seule)
SAXO_APP_SECRET=
SAXO_REDIRECT_URI=http://localhost/callback
SAXO_TOKEN_KEY=                             # clé Fernet : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SAXO_TOKEN_PATH=data/saxo_token.enc
SAXO_CLIENT_KEY=                            # ClientKey (port/v1/clients/me)

ANTHROPIC_API_KEY=                          # classification/rédaction (sinon repli par règles)
IMAP_USER=bourse.<nom>@gmail.com            # boîte dédiée aux newsletters
IMAP_PASSWORD=                              # mot de passe d'application Gmail (IMAP)

APP_API_TOKEN=                              # jeton applicatif pour n8n / webhooks (X-App-Token)
HEALTHCHECKS_PING_KEY=                      # healthchecks.io « ping key » (URLs par slug)
LOG_LEVEL=INFO
