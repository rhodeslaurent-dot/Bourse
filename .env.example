# Copier en .env (gitignoré) ou, mieux, laisser `uv run python -m app.cli env-setup <groupe>` le créer.
# Aucun secret ailleurs (CLAUDE.md règle 6). Les commentaires sont sur leur propre ligne : une ligne
# `CLE=   # texte` serait lue avec le texte pour valeur.

# Instance Postgres existante : réglé par `env-setup database`
DATABASE_URL=postgresql+psycopg://bourse:CHANGE_ME@postgres:5432/bourse
# réseau Docker de l'instance Postgres existante
POSTGRES_NETWORK=postgres_default
# dossier hôte des sauvegardes (défaut : ./backups) : `env-set BACKUP_HOST_DIR <dossier>`
# BACKUP_HOST_DIR=C:/Users/Laurent/OneDrive/bourse-backups
BACKUP_RETENTION_DAYS=30

# Telegram : `env-setup telegram` (user_id = votre identifiant numérique)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=0

# E-mail (SMTP Gmail, mot de passe d'application) : `env-setup imap`
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Cloudflare Tunnel + Access (phase P6 du RUNBOOK) ; tant que TEAM_DOMAIN et AUD sont vides, l'accès
# n'est pas protégé (lecture seule en local ; écritures refusées sauf ALLOW_UNAUTHENTICATED_WRITES=1)
CLOUDFLARE_TUNNEL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_EMAIL=

# EODHD (plan EOD+Intraday) : `env-setup eodhd`
EODHD_API_TOKEN=

# Saxo OpenAPI, application « usage personnel » sans droit de trading : `env-setup saxo` puis `saxo-auth`
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_REDIRECT_URI=http://localhost/callback
# clé Fernet générée par env-setup saxo
SAXO_TOKEN_KEY=
# jeton live ; la simulation utilise data/saxo_token.sim.enc
SAXO_TOKEN_PATH=data/saxo_token.enc
# live | sim (simulation : aucune donnée de marché)
SAXO_ENV=live
# ClientKey (port/v1/clients/me), écrit par saxo-check
SAXO_CLIENT_KEY=

# Claude (classification/rédaction ; sinon repli par règles) : `env-setup anthropic`
ANTHROPIC_API_KEY=
# boîte Gmail dédiée aux newsletters (IMAP, mot de passe d'application) : `env-setup imap`
IMAP_USER=
IMAP_PASSWORD=

# jeton applicatif pour n8n / webhooks (en-tête X-App-Token)
APP_API_TOKEN=
# healthchecks.io « ping key » : `env-setup healthchecks`
HEALTHCHECKS_PING_KEY=
LOG_LEVEL=INFO
# développement local seulement : autorise les écritures sans Cloudflare Access
# ALLOW_UNAUTHENTICATED_WRITES=1
